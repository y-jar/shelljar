#!/usr/bin/env bash
# shjapps — list applications as TSV: Name<TAB>Exec<TAB>Icon
# Scans the standard XDG application dirs for .desktop files.
# Output is deduplicated by desktop entry Name.

set -uo pipefail

DIRS=(
  "/run/current-system/sw/share/applications"
  "/etc/profiles/per-user/${USER:-user}/share/applications"
  "$HOME/.nix-profile/share/applications"
  "$HOME/.local/share/applications"
  "/usr/share/applications"
)

declare -A SEEN

for dir in "${DIRS[@]}"; do
  [[ -d "$dir" ]] || continue
  while IFS= read -r -d '' file; do
    name=""; exec_=""; icon=""
    while IFS='=' read -r key val; do
      case "$key" in
        Name)    name="$val" ;;
        Exec)    exec_="$val" ;;
        Icon)    icon="$val" ;;
      esac
    done < <(grep -E '^(Name|Exec|Icon)=' "$file" 2>/dev/null)
    [[ -z "$name" || -z "$exec_" ]] && continue
    # skip app launchers/terminals we already cover
    [[ -n "${SEEN[$name]:-}" ]] && continue
    SEEN["$name"]=1
    printf '%s\t%s\t%s\n' "$name" "$exec_" "${icon:-}"
  done < <(find "$dir" -maxdepth 1 -name '*.desktop' -type f -print0 2>/dev/null)
done | sort -u