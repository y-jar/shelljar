#!/usr/bin/env bash
# shjstats — one-line system stats poller for shelljar.
# Prints a single tab-separated line:
#   cpu%  ramUsed  ramTotal  dlBps  ulBps  diskUsed  diskTotal
# All units are bytes (disk too); the QML widget formats them.
# Deliberately zero-dependency: only /proc, /sys and df(1) from coreutils/minimal.

set -u

CACHE="${TMPDIR:-/tmp}/shjstats-${USER:-user}.cache"

now() { date +%s%N; }

# ---- CPU: total + idle jiffies across all CPUs (core-count independent) ----
# /proc/stat "cpu" line: user nice system idle iowait irq softirq steal guest guest_nice
read_cpu() {
  awk '/^cpu / {
    total=0; idle=$5+$6
    for (i=2; i<=NF; i++) total+=$i
    printf "%d %d", total, idle
  }' /proc/stat
}

# ---- RAM ----
read_mem() {
  awk '/^MemTotal:/ { t=$2 } /^MemAvailable:/ { a=$2 } END { printf "%d %d", (t-a)*1024, t*1024 }' /proc/meminfo
}

# ---- NET: sum rx/tx over non-loopback interfaces (bytes) ----
read_net() {
  local rx=0 tx=0
  local dev
  for dev in /sys/class/net/*; do
    local name="${dev##*/}"
    [[ "$name" == "lo" ]] && continue
    [[ -r "$dev/statistics/rx_bytes" ]] || continue
    rx=$(( rx + $(<"$dev/statistics/rx_bytes") ))
    tx=$(( tx + $(<"$dev/statistics/tx_bytes") ))
  done
  printf "%d %d" "$rx" "$tx"
}

# ---- DISK: root filesystem ----
read_disk() {
  df -P / | awk 'NR==2 { printf "%d %d", $3*1024, $2*1024 }'
}

# ---- delta calc using the cache file (prev_totalJiffies prev_idleJiffies prev_rx prev_tx prev_timeNs) ----
prev_total=0; prev_idle=0; prev_rx=0; prev_tx=0; prev_time=0
if [[ -r "$CACHE" ]]; then
  read -r prev_total prev_idle prev_rx prev_tx prev_time < "$CACHE"
fi

read -r CUR_TOTAL CUR_IDLE <<< "$(read_cpu)"
read -r CUR_RX CUR_TX <<< "$(read_net)"
CUR_TIME="$(now)"

CPU=0; DL=0; UL=0
if (( prev_time != 0 )); then
  dT=$(( (CUR_TIME - prev_time) / 1000000 )) # ms
  (( dT < 1 )) && dT=1

  tDelta=$(( CUR_TOTAL - prev_total ))
  iDelta=$(( CUR_IDLE - prev_idle ))
  if (( tDelta > 0 )); then
    CPU=$(( (tDelta - iDelta) * 100 / tDelta ))
    (( CPU < 0 )) && CPU=0; (( CPU > 100 )) && CPU=100
  fi

  DL=$(( (CUR_RX - prev_rx) * 1000 / dT ))
  UL=$(( (CUR_TX - prev_tx) * 1000 / dT ))
  (( DL < 0 )) && DL=0; (( UL < 0 )) && UL=0
fi

printf "%s %s %s %s %s\n" "$CUR_TOTAL" "$CUR_IDLE" "$CUR_RX" "$CUR_TX" "$CUR_TIME" > "$CACHE"

read -r RAM_USED RAM_TOTAL <<< "$(read_mem)"
read -r DISK_USED DISK_TOTAL <<< "$(read_disk)"

# clamp so the QML never sees negative/garbage values
(( RAM_USED < 0 )) && RAM_USED=0
(( RAM_TOTAL < 1 )) && RAM_TOTAL=1
(( DISK_USED < 0 )) && DISK_USED=0
(( DISK_TOTAL < 1 )) && DISK_TOTAL=1

printf "%d\t%d\t%d\t%d\t%d\t%d\t%d\n" "$CPU" "$RAM_USED" "$RAM_TOTAL" "$DL" "$UL" "$DISK_USED" "$DISK_TOTAL"